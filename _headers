# Security headers. Applied automatically by Cloudflare Pages and Netlify.
# GitHub Pages ignores this file; if the site stays on GitHub Pages behind
# Cloudflare, add the same headers once as a Cloudflare Transform Rule
# (Rules > Transform Rules > Modify Response Header). See README.md "Security".
#
# The policy mirrors the <meta> tag in index.html and the generated pages, and
# adds what a meta tag cannot: frame-ancestors, so the site can never be
# framed by another site.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-XSS-Protection: 0
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/data/*
  Cache-Control: public, max-age=300
/assets/*
  Cache-Control: public, max-age=86400
